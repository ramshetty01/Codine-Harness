NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
CODINE_MAX_TOKENS=4096
CODINE_MAX_STEPS=12
CODINE_CONTEXT_CHARS=160000

# Optional provider for the later paid evaluation stage; NVIDIA remains default.
CODINE_PROVIDER=nvidia
OPENROUTER_API_KEY=
# Set an explicit, verified model ID before choosing OpenRouter.
OPENROUTER_MODEL=
# Local session budget/reservation, not a provider-side billing cap.
CODINE_BUDGET_USD=3.50
CODINE_REQUEST_BUDGET_USD=0.25
